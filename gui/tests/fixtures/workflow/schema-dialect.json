{
  "contracts": {
    "findings": {
      "properties": {
        "findings": {
          "description": "Findings in canonical global rank order.",
          "items": {
            "properties": {
              "category": {
                "enum": [
                  "Correctness and Internal Consistency",
                  "Methodological and Evidentiary Concerns",
                  "Contribution and Scope",
                  "Exposition and Organization"
                ],
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              "consequence": {
                "minLength": 1,
                "type": "string"
              },
              "evidence": {
                "description": "Evidence locators supporting the finding. Every item needs a typed locator and begins unverified; only Pipeline's host verifier may promote it.",
                "items": {
                  "properties": {
                    "accessed_at": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "artifact_path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "asset_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "call_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "description": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "doi": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "evidence_type": {
                      "enum": [
                        "document",
                        "source",
                        "external",
                        "call"
                      ],
                      "type": "string"
                    },
                    "line_end": {
                      "description": "Last source line, at least line_start.",
                      "type": "integer"
                    },
                    "line_start": {
                      "description": "1-based source line.",
                      "type": "integer"
                    },
                    "node_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "page": {
                      "description": "1-based rendered page.",
                      "type": "integer"
                    },
                    "publisher": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "query_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "quote": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "source_hash": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "source_path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "url": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "verification_status": {
                      "enum": [
                        "unverified"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "evidence_type",
                    "verification_status",
                    "description"
                  ],
                  "type": "object"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              "id": {
                "description": "Stable descriptive identity; never an ordinal.",
                "minLength": 1,
                "type": "string"
              },
              "problem": {
                "minLength": 1,
                "type": "string"
              },
              "rank": {
                "description": "Canonical 1-based global rank, equal to array position.",
                "type": "integer"
              },
              "recommended_action": {
                "minLength": 1,
                "type": "string"
              },
              "reviewer_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 100,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string"
              },
              "source_call_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 100,
                "type": "array",
                "uniqueItems": true
              },
              "source_key": {
                "minLength": 1,
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              },
              "verification_status": {
                "enum": [
                  "unverified"
                ],
                "type": "string"
              }
            },
            "required": [
              "rank",
              "id",
              "title",
              "category",
              "severity",
              "confidence",
              "verification_status",
              "reviewer_ids",
              "problem",
              "consequence",
              "recommended_action",
              "evidence"
            ],
            "type": "object"
          },
          "maxItems": 40,
          "type": "array"
        },
        "schema_version": {
          "enum": [
            2
          ],
          "type": "integer"
        },
        "taxonomy": {
          "items": {
            "enum": [
              "Correctness and Internal Consistency",
              "Methodological and Evidentiary Concerns",
              "Contribution and Scope",
              "Exposition and Organization"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "taxonomy",
        "findings"
      ],
      "title": "Canonical findings v2",
      "type": "object",
