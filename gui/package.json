{
  "name": "pipeline-gui",
  "private": true,
  "version": "1.0.1",
  "description": "Native desktop app for multi-pass, LLM-assisted document review",
  "homepage": "https://github.com/mdroste/pipeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdroste/pipeline.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.12.0 || >=24.18.0 <25"
  },
  "overrides": {
    "@wdio/tauri-service": {
      "@wdio/native-utils": "2.5.0"
    },
    "brace-expansion": "5.0.8",
    "diff": "8.0.4",
    "esbuild": "0.28.1",
    "minimatch": "10.2.6",
    "mocha": "11.7.6",
    "serialize-javascript": "7.0.7",
    "undici@^7.0.0": "7.29.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:release-resources": "node ../scripts/release/prepare-notices.mjs",
    "test:release": "node --test ../scripts/release/release.test.mjs && node ../scripts/release/validate-release-identity.mjs",
    "test:e2e": "wdio run ./wdio.conf.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^4.1.4",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.4"
  }
}
