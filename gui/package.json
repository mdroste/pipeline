{
  "name": "pipeline-gui",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop agent orchestration suite for academic research and review",
  "homepage": "https://github.com/mdroste/pipeline",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdroste/pipeline.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.12.0 || >=24.18.0 <25"
  },
  "overrides": {
    "@wdio/tauri-service": {
      "@wdio/native-utils": "2.5.0"
    },
    "brace-expansion": "5.0.12",
    "diff": "9.0.0",
    "esbuild": "0.28.1",
    "ip-address": "10.7.3",
    "js-yaml@^4.0.0": "4.3.2",
    "minimatch": "10.2.6",
    "mocha": "11.7.6",
    "nanoid@^3.0.0": "3.3.18",
    "serialize-javascript": "7.0.7",
    "undici@^6.0.0": "6.28.1",
    "undici@^7.0.0": "7.29.1",
    "undici@^8.0.0": "8.10.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:release-resources": "node ../scripts/release/prepare-package-notices.mjs",
    "test:release": "node --test ../scripts/release/release.test.mjs && node ../scripts/release/validate-release-identity.mjs",
    "test:e2e": "wdio run ./wdio.conf.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check:source-size": "node ../scripts/source-size-report.mjs --check",
    "check:links": "node ../scripts/check-markdown-links.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2",
    "codemirror": "^6.0.2",
    "diff": "9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
