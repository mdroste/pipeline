{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipeline",
  "version": "../package.json",
  "identifier": "com.pipeline.report",
  "build": {
    "beforeDevCommand": "npm run prepare:release-resources && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:release-resources && npm run build",
    "beforeBundleCommand": "node ../scripts/release/sign-macos-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pipeline",
        "width": 1400,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; font-src 'self' blob:; img-src 'self' data: pipeline-file: http://pipeline-file.localhost; media-src 'self' pipeline-file: http://pipeline-file.localhost; frame-src pipeline-file: http://pipeline-file.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost pipeline-file: http://pipeline-file.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQzEwN0U3MzEzMjUxNjIKUldSaVVUSXg1d2ZCdnBXaFFUMlpSVTZqbDlBNGo3UzI5YUFhY25jWVl1QnFZUlNXTW1GTmhPU1YK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "prompts/*",
      "resources/poppler/**/*",
      "resources/notices/NOTICE.txt",
      "resources/notices/PIPELINE_LICENSE.txt",
      "resources/notices/THIRD_PARTY_LIBRARIES.txt",
      "resources/notices/THIRD_PARTY_LICENSES.md"
    ],
    "copyright": "Copyright © 2026 Michael Droste",
    "macOS": {
      "minimumSystemVersion": "15.0",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 430 },
        "appPosition": { "x": 170, "y": 152 },
        "applicationFolderPosition": { "x": 490, "y": 152 }
      }
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/nsis-hooks.nsh"
      }
    }
  }
}
