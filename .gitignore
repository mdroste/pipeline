# Rust / Cargo
/gui/src-tauri/target/
**/*.rs.bk
*.pdb

# Tauri generated
/gui/src-tauri/gen/schemas/

# Node
/gui/node_modules/
/gui/dist/
/gui/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python test caches
__pycache__/
*.py[cod]

# Build outputs / bundles
*.app
*.dmg
*.msi
*.exe
*.deb
*.AppImage
*.rpm

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# Local test fixtures
/gui/test.pdf

# Bundled poppler binaries — populated per-platform by CI, not committed
/gui/src-tauri/resources/poppler/*
!/gui/src-tauri/resources/poppler/.gitkeep
!/gui/src-tauri/resources/poppler/README.md

# Package notices are generated before Tauri builds; no complete SBOM is produced.
/gui/src-tauri/resources/notices/*
!/gui/src-tauri/resources/notices/.gitkeep
!/gui/src-tauri/resources/notices/README.md

# Local environment / secrets
.env
.env.local
.env.*.local

# Agent instruction files (local only)
CLAUDE.md
AGENTS.md
/.claude/settings.local.json
