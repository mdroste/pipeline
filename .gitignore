# Rust / Cargo
/gui/src-tauri/target/
**/*.rs.bk
*.pdb

# Tauri generated
/gui/src-tauri/gen/schemas/

# Node
node_modules/
/gui/dist/
/gui/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python test caches
__pycache__/
*.py[cod]

# Build outputs / bundles
*.app
*.dmg
*.msi
*.exe
*.deb
*.AppImage
*.rpm

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# Local test fixtures
/gui/test.pdf

# Bundled poppler binaries — populated per-platform by CI, not committed
/gui/src-tauri/resources/poppler/*
!/gui/src-tauri/resources/poppler/.gitkeep
# Windows llama.cpp Vulkan build — populated by CI, not committed
/gui/src-tauri/resources/llama-vulkan/

# Package notices are generated before Tauri builds; no complete SBOM is produced.
/gui/src-tauri/resources/notices/*
!/gui/src-tauri/resources/notices/.gitkeep

# Local environment / secrets
.env
.env.local
.env.*.local

# Agent instructions, skill links, and app settings (local only)
CLAUDE.md
AGENTS.md
/.claude/
/.agents/

# Agent-written audits, plans, and progress reports stay on the local machine.
/reports/

# AI-generated reviews, audits, and plans written under AGENTS.md (local only).
/reviews/
